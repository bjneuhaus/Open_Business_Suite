# Gepinnter OpenCloud-Container-Image-Verweis (verifizierter Digest).
#
# Einzige Quelle der Wahrheit, verwendet von:
#   - src/sovereign_business_suite/services/opencloud_service.py
#     (default_opencloud_config())
#   - scripts/provision_opencloud.sh (Pull des gepinnten Images)
#   - docs/opencloud-service.md (manueller Bootstrap-Ablauf)
#
# Aktualisieren: neues Image ziehen, Herkunft/Vertrauen pruefen, Digest
# auslesen mit:
#   podman inspect <repository>:<tag> --format '{{.RepoDigests}}'
# und OPENCLOUD_IMAGE_DIGEST unten aktualisieren.
#
# Verifiziert am 2026-08-31 auf der PoC-VM (training@116.202.97.223):
# podman images --digests docker.io/opencloudeu/opencloud-rolling
OPENCLOUD_IMAGE_REPOSITORY=docker.io/opencloudeu/opencloud-rolling
OPENCLOUD_IMAGE_DIGEST=sha256:6db1cfb06d430a663f16e9f33dcd4596d82a4875be0b4df233c26ce5f667ea74
